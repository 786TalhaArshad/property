php_value max_execution_time 300
php_value memory_limit 256M
php_value upload_max_filesize 50M
php_value post_max_size 55M
php_value max_input_vars 5000

<Files "includes/config.php">
    Order Allow,Deny
    Deny from all
</Files>

<FilesMatch "\.(sql|log|env)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
